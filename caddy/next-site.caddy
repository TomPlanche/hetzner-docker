# next-site: the preview of the `next` branch of the front (port 3001).
next.tomplanche.com {
	# A branch preview: keep it out of the search engines.
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy 10.10.0.4:3101 {
		# A restart of the app (a deploy): Caddy tries again during 15 seconds,
		# so the request waits instead of getting the 503 page below. Caddy
		# always retries a request that it could not send. After a connection,
		# it retries only a GET, so a POST never goes twice.
		lb_try_duration 15s
	}

	# The app does not answer after 15 seconds (ronron or WireGuard is down): a
	# short page instead of an empty 502. The maintenance page of the app (a 503
	# that the app sends) is not an error of Caddy: it does not come here.
	handle_errors 502 504 {
		header Retry-After 120
		respond "This site is down for a moment. Try again in a few minutes." 503
	}
}
