# site: the portfolio front (port 3000), vps-back under /api/, and static
# pages under /sifa-page/ and /dither/.
#
# site and vps-back run on ronron. When ronron does not answer, the standby
# copies of the VPS (ports 3000 and 8000) answer instead (_failover.caddy).
tomplanche.com {
	handle_path /.well-known/atproto-did {
		respond "did:plc:ybx6os5vaaksppbxwvqqciaf"
	}

	# The routes of vps-back have no /api prefix.
	handle /api/* {
		uri strip_prefix /api
		import failover 10.10.0.4:8100 127.0.0.1:8000 /
	}

	redir /sifa-page /sifa-page/
	handle_path /sifa-page/* {
		root * /var/www/sifa-page
		try_files {path} {path}.html
		file_server
		encode zstd gzip
	}

	redir /dither /dither/
	handle_path /dither/* {
		root * /var/www/dither
		encode zstd gzip

		@hashed path_regexp \-[0-9a-f]{8,}\.(js|wasm|css)$
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		@samples path /samples/*
		header @samples Cache-Control "public, max-age=604800"

		file_server
	}

	handle {
		import failover 10.10.0.4:3100 127.0.0.1:3000 /_app/version.json
	}

	# An app does not answer, neither on ronron nor on the VPS: a short page
	# instead of an empty 502. A 503 comes from Caddy when no upstream is
	# healthy. A 503 that an app sends itself is not an error of Caddy: it does
	# not come here. The static pages above do not need the apps.
	handle_errors 502 503 504 {
		header Retry-After 120
		respond "This site is down for a moment. Try again in a few minutes." 503
	}
}
