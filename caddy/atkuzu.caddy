# atkuzu: the Takuzu game (port 3002). The app serves the dailies itself, from
# data/atkuzu/daily (DAILY_DIR).
atkuzu.tomplanche.com {
	encode zstd gzip
	reverse_proxy 10.10.0.4:3102

	# The app does not answer (a restart, or its server is down): a short page
	# instead of an empty 502.
	handle_errors 502 504 {
		header Retry-After 120
		respond "This site is down for a moment. Try again in a few minutes." 503
	}
}
