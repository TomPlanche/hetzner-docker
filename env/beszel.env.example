# Env file of the Beszel hub. Copy to env/beszel.env for production. The values
# below are the ones of `just local-up`.

# The first user (an admin), created at the first start of the hub only.
# `just beszel-setup` also logs in with it to connect the agent.
USER_EMAIL=admin@example.com
USER_PASSWORD=local-test-password

# The URL that opens the hub, for the links in alerts. Production, through
# `just beszel-tunnel`: http://localhost:8090.
APP_URL=http://localhost:8091
