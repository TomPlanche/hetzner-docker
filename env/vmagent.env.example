# Env file of vmagent. Copy to env/vmagent.env for production. The value below
# is the one of `just local-up`.

# The write URL of VictoriaMetrics: http://<address>:8428/api/v1/write.
# Production: the address of the server of VictoriaMetrics, on the private
# network (WireGuard). The local test uses the VictoriaMetrics of
# compose.local.yaml.
remoteWrite_url=http://victoriametrics:8428/api/v1/write
